# ── Frontend (Vite) ──
VITE_SUPA_URL=https://tu-proyecto.supabase.co
VITE_SUPA_KEY=tu-anon-key-de-supabase
VITE_ADMIN_TEL=595XXXXXXXXX
VITE_API_SECRET=mismo-valor-que-API_SECRET

# ── Backend / Vercel (Serverless) ──
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
API_SECRET=un-secreto-largo-y-aleatorio

# ── WhatsApp Cloud API (Meta) ──
WHATSAPP_TOKEN=tu-token-permanente
WHATSAPP_PHONE_NUMBER_ID=id-del-numero-de-la-empresa
WHATSAPP_VERIFY_TOKEN=token-de-verificacion-del-webhook
WHATSAPP_ADMIN_NOTIFY=595981086046          # TU WhatsApp personal (recibe avisos)

# Opcionales / nuevos
WHATSAPP_APP_SECRET=app-secret-de-meta       # valida la firma del webhook (X-Hub-Signature-256)
WHATSAPP_WABA_ID=id-de-la-cuenta-whatsapp    # lista y envía plantillas desde el panel
WHATSAPP_API_VERSION=v21.0                   # versión de la Graph API (default v21.0)
